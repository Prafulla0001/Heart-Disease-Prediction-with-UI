# Health Prediction & Wellness System Environment Configuration
# Set locally; never commit real provider keys.
# Providers are tried in this order: Grok, Gemini, then OmniRoute.
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OmniRoute fallback, using its configured OpenAI-compatible chat model.
OMNIROUTE_API_KEY=your_omniroute_api_key_here
# OmniRoute API base URL. Use HTTPS remotely; HTTP is allowed for localhost only.
OMNIROUTE_BASE_URL=
# Use an exact model ID supported by your OmniRoute endpoint.
# Model output is informational only and is not a clinical diagnosis.
OMNIROUTE_MODEL=

# Tavily is a web-search API, not a chat model; it is not used for chatbot replies.

# Health history storage: "local" uses health_history.json; "mysql" uses hosted MySQL.
HEALTH_HISTORY_STORAGE=local
# For hosted MySQL, use sslMode=VERIFY_IDENTITY and a least-privilege DB account.
# Copy these settings into your ignored .env file and replace the placeholders.
HEALTH_DB_URL=jdbc:mysql://YOUR_HOST:3306/YOUR_DATABASE?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC&connectTimeout=10000&socketTimeout=15000
HEALTH_DB_USER=YOUR_RESTRICTED_USER
HEALTH_DB_PASSWORD=YOUR_DATABASE_PASSWORD